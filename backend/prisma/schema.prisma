generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
}

enum DeliveryMethod {
  HOME
  PICKUP
}

enum PaymentMethod {
  CASH
  CARD
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  CANCELLED
}

model User {
  id               String   @id @default(uuid())
  phoneNumber      String   @unique @map("phone_number") @db.VarChar(20)
  passwordHash     String   @map("password_hash") @db.VarChar(255)
  displayName      String   @default("") @map("display_name") @db.VarChar(255)
  role             UserRole @default(USER)
  isPro            Boolean  @default(false) @map("is_pro")
  shopName         String   @default("") @map("shop_name") @db.VarChar(255)
  shopLogoUrl      String   @default("") @map("shop_logo_url") @db.VarChar(512)
  shopDescription  String?  @map("shop_description") @db.Text
  authProvider     String   @default("phone_password") @map("auth_provider") @db.VarChar(50)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  refreshTokens          RefreshToken[]
  listings               Listing[]
  favorites              Favorite[]
  buyerThreads           ChatThread[]             @relation("BuyerThreads")
  sellerThreads          ChatThread[]             @relation("SellerThreads")
  chatParticipants       ChatThreadParticipant[]
  chatMessages           ChatMessage[]
  notificationsReceived  Notification[]           @relation("NotificationRecipient")
  notificationsRead      Notification[]           @relation("NotificationReadBy")
  buyerOrders            Order[]                  @relation("BuyerOrders")
  sellerOrders           Order[]                  @relation("SellerOrders")
  uploads                Upload[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Listing {
  id              String        @id @default(uuid())
  ownerId         String        @map("owner_id")
  title           String        @db.VarChar(500)
  description     String?       @db.Text
  priceCents      Int           @default(0) @map("price_cents")
  currency        String        @default("MAD") @db.VarChar(3)
  category        String        @default("") @db.VarChar(100)
  city            String        @default("") @db.VarChar(50)
  youtubeVideoId  String        @default("") @map("youtube_video_id") @db.VarChar(20)
  videoUrl        String        @default("") @map("video_url") @db.VarChar(512)
  thumbnailUrl    String        @default("") @map("thumbnail_url") @db.VarChar(512)
  status          ListingStatus @default(PENDING)
  viewCount       Int?          @map("view_count")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  owner    User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images   ListingImage[]
  favorites Favorite[]
  threads  ChatThread[]
  orders   Order[]
  messages ChatMessage[]

  @@index([status, createdAt(sort: Desc)])
  @@index([ownerId, createdAt(sort: Desc)])
  @@index([category])
  @@index([city])
  @@map("listings")
}

model ListingImage {
  id        String @id @default(uuid())
  listingId String @map("listing_id")
  url       String @db.VarChar(512)
  sortOrder Int    @default(0) @map("sort_order")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@map("listing_images")
}

model Favorite {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  listingId    String   @map("listing_id")
  title        String   @default("") @db.VarChar(500)
  priceCents   Int      @default(0) @map("price_cents")
  currency     String   @default("MAD") @db.VarChar(3)
  thumbnailUrl String   @default("") @map("thumbnail_url") @db.VarChar(512)
  city         String   @default("") @db.VarChar(50)
  ownerId      String   @map("owner_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@map("favorites")
}

model ChatThread {
  id              String    @id @default(uuid())
  listingId       String    @map("listing_id")
  buyerId         String    @map("buyer_id")
  sellerId        String    @map("seller_id")
  productTitle    String    @default("") @map("product_title") @db.VarChar(500)
  productThumb    String    @default("") @map("product_thumb") @db.VarChar(512)
  priceLabel      String    @default("") @map("price_label") @db.VarChar(100)
  lastMessageText String?   @map("last_message_text") @db.Text
  lastMessageAt   DateTime? @map("last_message_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  listing      Listing                 @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer        User                    @relation("BuyerThreads", fields: [buyerId], references: [id], onDelete: Cascade)
  seller       User                    @relation("SellerThreads", fields: [sellerId], references: [id], onDelete: Cascade)
  participants ChatThreadParticipant[]
  messages     ChatMessage[]

  @@unique([listingId, buyerId])
  @@index([buyerId, createdAt(sort: Desc)])
  @@index([sellerId, createdAt(sort: Desc)])
  @@map("chat_threads")
}

model ChatThreadParticipant {
  threadId String @map("thread_id")
  userId   String @map("user_id")

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
  @@index([userId])
  @@map("chat_thread_participants")
}

model ChatMessage {
  id        String   @id @default(uuid())
  threadId  String   @map("thread_id")
  senderId  String   @map("sender_id")
  text      String?  @db.Text
  imageUrl  String?  @map("image_url") @db.VarChar(512)
  listingId String?  @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")

  thread  ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender  User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  listing Listing?   @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt(sort: Asc)])
  @@map("chat_messages")
}

model Notification {
  id          String    @id @default(uuid())
  recipientId String    @map("recipient_id")
  senderName  String    @default("") @map("sender_name") @db.VarChar(255)
  message     String    @db.Text // required content
  type        String    @default("generic") @db.VarChar(50)
  isRead      Boolean   @default(false) @map("is_read")
  link        Json?
  readAt      DateTime? @map("read_at")
  readById    String?   @map("read_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  readBy    User? @relation("NotificationReadBy", fields: [readById], references: [id], onDelete: SetNull)

  @@index([recipientId, isRead])
  @@index([recipientId, createdAt(sort: Desc)])
  @@map("notifications")
}

model Order {
  id                  String          @id @default(uuid())
  orderNumber         String          @unique @map("order_number") @db.VarChar(20)
  buyerId             String          @map("buyer_id")
  sellerId            String          @map("seller_id")
  listingId           String          @map("listing_id")
  listingTitle        String          @default("") @map("listing_title") @db.VarChar(500)
  listingThumbnailUrl String          @default("") @map("listing_thumbnail_url") @db.VarChar(512)
  priceCents          Int             @default(0) @map("price_cents")
  subtotalCents       Int             @default(0) @map("subtotal_cents")
  shippingFeeCents    Int             @default(0) @map("shipping_fee_cents")
  totalCents          Int             @default(0) @map("total_cents")
  currency            String          @default("MAD") @db.VarChar(3)
  deliveryMethod      DeliveryMethod  @default(HOME) @map("delivery_method")
  paymentMethod       PaymentMethod   @default(CASH) @map("payment_method")
  status              OrderStatus     @default(PENDING)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  buyer    User           @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User           @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)
  listing  Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  delivery OrderDelivery?

  @@index([sellerId, createdAt(sort: Desc)])
  @@index([buyerId, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderDelivery {
  orderId  String @id @map("order_id")
  fullName String @default("") @map("full_name") @db.VarChar(255)
  phone    String @default("") @db.VarChar(20)
  address  String @default("") @db.VarChar(500)
  city     String @default("") @db.VarChar(100)
  zip      String @default("") @db.VarChar(20)
  notes    String? @db.Text

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_delivery")
}

model Upload {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  sizeBytes    Int      @map("size_bytes")
  storagePath  String   @map("storage_path") @db.VarChar(512)
  publicUrl    String   @map("public_url") @db.VarChar(512)
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("uploads")
}

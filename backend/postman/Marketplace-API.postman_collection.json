{
  "info": {
    "name": "Marketplace API",
    "description": "Express + MySQL backend for marketplace-web",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3002/api" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "listingId", "value": "" },
    { "key": "threadId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data?.accessToken) pm.collectionVariables.set('accessToken', j.data.accessToken);",
                  "if (j.data?.refreshToken) pm.collectionVariables.set('refreshToken', j.data.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"612345678\",\n  \"password\": \"test123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data?.accessToken) pm.collectionVariables.set('accessToken', j.data.accessToken);",
                  "if (j.data?.refreshToken) pm.collectionVariables.set('refreshToken', j.data.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"600000000\",\n  \"password\": \"admin123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data?.accessToken) pm.collectionVariables.set('accessToken', j.data.accessToken);",
                  "if (j.data?.refreshToken) pm.collectionVariables.set('refreshToken', j.data.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get User",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "Update Me",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shopName\": \"My Shop\",\n  \"shopDescription\": \"Welcome\"\n}"
            },
            "url": "{{baseUrl}}/users/me"
          }
        }
      ]
    },
    {
      "name": "Listings",
      "item": [
        {
          "name": "List Approved",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/listings?status=approved&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["listings"],
              "query": [
                { "key": "status", "value": "approved" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "List Pending (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/listings?status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["listings"],
              "query": [{ "key": "status", "value": "pending" }]
            }
          }
        },
        {
          "name": "Create Listing",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data?.listing?.id) pm.collectionVariables.set('listingId', j.data.listing.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Listing\",\n  \"priceCents\": 150000,\n  \"category\": \"Electronics\",\n  \"city\": \"casablanca\"\n}"
            },
            "url": "{{baseUrl}}/listings"
          }
        },
        {
          "name": "Get Listing",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/listings/{{listingId}}"
          }
        },
        {
          "name": "Update Listing",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Title\",\n  \"priceCents\": 160000\n}"
            },
            "url": "{{baseUrl}}/listings/{{listingId}}"
          }
        },
        {
          "name": "Approve Listing",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/listings/{{listingId}}/approve"
          }
        },
        {
          "name": "Reject Listing",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/listings/{{listingId}}/reject"
          }
        },
        {
          "name": "Delete Listing",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/listings/{{listingId}}"
          }
        }
      ]
    },
    {
      "name": "Favorites",
      "item": [
        {
          "name": "List Favorites",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/favorites"
          }
        },
        {
          "name": "Add Favorite",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingId\": \"{{listingId}}\"\n}"
            },
            "url": "{{baseUrl}}/favorites"
          }
        },
        {
          "name": "Remove Favorite",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/favorites/{{listingId}}"
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "List Threads",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/chat/threads"
          }
        },
        {
          "name": "Get or Create Thread",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data?.thread?.id) pm.collectionVariables.set('threadId', j.data.thread.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingId\": \"{{listingId}}\"\n}"
            },
            "url": "{{baseUrl}}/chat/threads"
          }
        },
        {
          "name": "Get Messages",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/chat/threads/{{threadId}}/messages"
          }
        },
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hello!\"\n}"
            },
            "url": "{{baseUrl}}/chat/threads/{{threadId}}/messages"
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Unread Count",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/notifications/unread-count"
          }
        },
        {
          "name": "List Notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/notifications"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data?.order?.id) pm.collectionVariables.set('orderId', j.data.order.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingId\": \"{{listingId}}\",\n  \"sellerUid\": \"seller-user-id\",\n  \"subtotalCents\": 150000,\n  \"shippingFeeCents\": 0,\n  \"delivery\": {\n    \"fullName\": \"Buyer Name\",\n    \"phone\": \"+212600000001\",\n    \"address\": \"123 Street\",\n    \"city\": \"Casablanca\",\n    \"zip\": \"20000\"\n  }\n}"
            },
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "List Orders (Seller)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/orders?role=seller",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [{ "key": "role", "value": "seller" }]
            }
          }
        },
        {
          "name": "Confirm Order",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"confirm\"\n}"
            },
            "url": "{{baseUrl}}/orders/{{orderId}}/status"
          }
        }
      ]
    },
    {
      "name": "Uploads",
      "item": [
        {
          "name": "Upload File",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": "" }]
            },
            "url": "{{baseUrl}}/uploads"
          }
        }
      ]
    }
  ]
}

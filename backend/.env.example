# Server
NODE_ENV=development
PORT=3002
API_BASE_URL=http://localhost:3002

# CORS — React dev server
CORS_ORIGIN=http://localhost:3000

# Database (matches docker-compose defaults)
DATABASE_URL=mysql://app_user:app_password@localhost:3306/app_db

# --- O2switch production (set in cPanel Setup Node.js App → Environment variables) ---
# NODE_ENV=production
# PORT=3002
# API_BASE_URL=https://api.yourdomain.com
# CORS_ORIGIN=https://yourdomain.com
# DATABASE_URL=mysql://cpanel_user:password@localhost:3306/cpanel_dbname
# UPLOAD_DIR=uploads

# Docker MySQL (used by docker-compose.yml)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Super admin seed (prisma db seed)
SUPER_ADMIN_PHONE=+212600000000
SUPER_ADMIN_PASSWORD=admin123456

# Seed data (npm run db:seed)
SEED_RESET=true
SEED_USER_PASSWORD=Seed123!

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# YouTube — centralized uploads to @mageDev-m2r (see backend/scripts/youtube-oauth-setup.js)
# 1. Enable YouTube Data API v3 in Google Cloud Console
# 2. OAuth consent screen: add youtube.upload (+ youtube.readonly optional)
# 3. Create Web application OAuth client; set redirect URI for setup script (default below)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Channel ID from YouTube Studio → Settings → Advanced (optional; resolved from handle if empty)
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_HANDLE=mageDev-m2r
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3333/oauth/callback
YOUTUBE_MAX_VIDEO_MB=200
YOUTUBE_PRIVACY_STATUS=unlisted
YOUTUBE_CATEGORY_ID=22
